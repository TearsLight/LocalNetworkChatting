{
  "name": "websocket-chat-server",
  "version": "3.0.0",
  "description": "WebSocket聊天服务器 - Vue 3 + Vite + Tailwind CSS Frontend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:client": "cd client && npm run dev",
    "build:client": "cd client && npm run build",
    "clean-old": "node scripts/cleanup.js",
    "stats": "node scripts/stats.js",
    "export": "node scripts/export.js"
  },
  "keywords": [
    "websocket",
    "chat",
    "sqlite",
    "realtime",
    "vue",
    "tailwindcss"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.9.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
